# Copy to .env.local (never commit .env.local).
# Supabase Dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). Safe in the browser: RLS decides what it can read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional fallback for the sign-in link when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
