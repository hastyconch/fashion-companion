{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "fashion-companion",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding; the service name must match the worker name.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "fashion-companion"
		}
	],
	// Runs the Worker close to the database: pages make several Supabase calls
	// each, so cutting each round trip matters more than the first hop.
	"placement": { "mode": "smart" },
	"observability": {
		"enabled": true
	},
	// Pull requests deploy as Worker Previews (`wrangler preview` in Workers Builds),
	// which refuse to run without this block. The self-reference service binding is
	// left out on purpose: only OpenNext's revalidation queue uses it, and we don't.
	// Previews have their own secrets (`wrangler preview secret`): without an Anthropic key
	// there, AI tagging and outfits show as not set up. They share the live Supabase data.
	"previews": {
		"placement": { "mode": "smart" }
	}
}
